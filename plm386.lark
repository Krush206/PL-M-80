?start: module

# 1 LEXICAL ELEMENTS

RESERVED_WORD.2: /ADDRESS\b/i | /AND\b/i | /AT\b/i | /BASED\b/i | /BYTE\b/i | /BY\b/i | /CALL\b/i
    | /CASE\b/i | /CHARINT\b/i | /DATA\b/i | /DECLARE\b/i | /DISABLE\b/i | /DO\b/i
    | /DWORD\b/i | /ELSE\b/i | /ENABLE\b/i | /END\b/i | /EOF\b/i | /EXTERNAL\b/i 
    | /GOTO\b/i | /GO\b/i | /HALT\b/i | /HWORD\b/i | /IF\b/i | /INITIAL\b/i | /INTEGER\b/i
    | /INTERRUPT\b/i | /LABEL\b/i | /LITERALLY\b/i | /LONGINT\b/i | /MINUS\b/i | /MOD\b/i
    | /NOT\b/i | /OFFSET\b/i | /OR\b/i | /PLUS\b/i | /POINTER\b/i | /PROCEDURE\b/i
    | /PUBLIC\b/i | /REAL\b/i | /REENTRANT\b/i | /RETURN\b/i | /SELECTOR\b/i
    | /SHORTINT\b/i | /STRUCTURE\b/i | /THEN\b/i | /TO\b/i | /WHILE\b/i | /WORD\b/i
    | /QWORD\b/i | /XOR\b/i

IDENTIFIER: /(?! ADDRESS\b | AND\b | AT\b | BASED\b | BYTE\b | BY\b | CALL\b
    | CASE\b | CHARINT\b | DATA\b | DECLARE\b | DISABLE\b | DO\b
    | DWORD\b | ELSE\b | ENABLE\b | END\b | EOF\b | EXTERNAL\b
    | GOTO\b | GO\b | HALT\b | HWORD\b | IF\b | INITIAL\b | INTEGER\b
    | INTERRUPT\b | LABEL\b | LITERALLY\b | LONGINT\b | MINUS\b | MOD\b
    | NOT\b | OFFSET\b | OR\b | PLUS\b | POINTER\b | PROCEDURE\b
    | PUBLIC\b | REAL\b | REENTRANT\b | RETURN\b | SELECTOR\b
    | SHORTINT\b | STRUCTURE\b | THEN\b | TO\b | WHILE\b | WORD\b
    | QWORD\b | XOR\b ) [a-z_][a-z0-9$_]*\b/ix

# Numeric Constants
numeric_constant: BINARY_NUMBER | OCTAL_NUMBER | DECIMAL_NUMBER
    | HEXADECIMAL_NUMBER | FLOATING_POINT_NUMBER

BINARY_NUMBER: /[01][01$]*b\b/i
OCTAL_NUMBER: /[0-7][0-7$]*[oq]\b/i
DECIMAL_NUMBER: /[0-9][0-9$]*d?\b/i
HEXADECIMAL_NUMBER: /[0-9][0-9a-f$]*h\b/i
FLOATING_POINT_NUMBER: DIGIT_STRING ("." DIGIT_STRING)? FRACTIONAL_PART
FRACTIONAL_PART: /E[+-]/i DIGIT_STRING
DIGIT_STRING: /[0-9][0-9$]*/

# Strings
STRING: "'" ( /[^']/ | "''" )* "'"
TODO: /\x1a/

# terminal: RESERVED_WORD | IDENTIFIER | numeric_constant | STRING



# 2 MODULES
module: IDENTIFIER ":" simple_do_block

# 3 DECLARATIONS
?declaration: declare_statement | procedure_definition

# 3.1 Declare Statement
declare_statement: /DECLARE\b/i declare_element_list ";"
declare_element_list: declare_element ("," declare_element)*
?declare_element: factored_element | unfactored_element
?unfactored_element: variable_element | literal_element | label_element
?factored_element: factored_variable_element | factored_label_element

# 3.2 Variable Elements
variable_element: variable_name_specifier \
	array_specifier? variable_type variable_attributes?
variable_name_specifier: IDENTIFIER (/BASED\b/i base_specifier)?
base_specifier: IDENTIFIER ("." IDENTIFIER)?
variable_attributes: (/PUBLIC\b/i | locator | initialization
    | /EXTERNAL\b/i | /DATA\b/i)+
locator: "AT"i "(" expression ")"
constant_attribute: /DATA\b/i
?array_specifier: explicit_dimension | implicit_dimension
explicit_dimension: "(" numeric_constant ")"
implicit_dimension: "(" "*" ")"
variable_type: BASIC_TYPE | structure_type
BASIC_TYPE: /ADDRESS\b/i | /BYTE\b/i | /WORD\b/i | /HWORD\b/i | /DWORD\b/i
    | /QWORD\b/i | /CHARINT\b/i | /OFFSET\b/i | /SHORTINT\b/i | /INTEGER\b/i
    | /REAL\b/i | /SELECTOR\b/i | /POINTER\b/i | /OFFSET\b/i

# 3.3 Label Element
label_element: IDENTIFIER /LABEL\b/i (/PUBLIC\b/i | /EXTERNAL\b/i)?

# 3.4 Literal Elements
literal_element: IDENTIFIER "LITERALLY"i STRING

# EXTRA
parens_factored: "("variable_name_specifier ("," variable_name_specifier) * ")"

# 3.5 Factored Variable Element
factored_variable_element: parens_factored \
        explicit_dimension? variable_type variable_attributes?

# 3.6 Factored Label Element
factored_label_element: parens_factored \
        /LABEL\b/i (/PUBLIC\b/i | /EXTERNAL\b/i)?

# 3.7 The Structure Type
structure_type: /STRUCTURE\b/i "(" member_element ("," member_element)* ")"
member_element: unfactored_member | factored_member
unfactored_member: IDENTIFIER explicit_dimension? variable_type
factored_member: "(" IDENTIFIER ("," IDENTIFIER)* ")" \
        explicit_dimension? variable_type

# 3.8 Procedure Definition
procedure_definition: procedure_statement proc_decls proc_units ending
proc_decls: declaration*
proc_units: unit*
procedure_statement: IDENTIFIER ":" "PROCEDURE"i \
        formal_parameter_list? procedure_type? procedure_attributes? ";"
procedure_type: BASIC_TYPE
formal_parameter_list: "(" IDENTIFIER ("," IDENTIFIER)* ")"
procedure_attributes: PROCEDURE_ATTRIBUTE+
PROCEDURE_ATTRIBUTE: /EXTERNAL\b/i | /PUBLIC\b/i | /INTERRUPT\b/i | /REENTRANT\b/i

# 3.9 Attributes
initialization: ("INITIAL"i | "DATA"i)  \
        "(" expression ( "," expression )* ")"

# 4. UNITS
?unit: conditional_clause | do_block | basic_statement | label_definition unit
?basic_statement: assignment_statement | call_statement | goto_statement
    | null_statement | return_statement | microprocessor_dependent_statement
# scoping_statement: simple_do_statement | do_case_statement
#    | do_while_statement | iterative_do_statement | end_statement
#    | procedure_statement
label_definition: IDENTIFIER ":"

# 4.1 Basic Statements
assignment_statement: left_part "=" expression ";"
?left_part: variable_reference ("," variable_reference)*
call_statement: /CALL\b/i simple_variable parameter_list? ";"
parameter_list: "(" expression ("," expression)* ")"
simple_variable: IDENTIFIER ("." IDENTIFIER)?
goto_statement: (/GOTO\b/i | /GO\b/i /TO\b/i) IDENTIFIER ";"
null_statement: ";"
return_statement: typed_return | untyped_return
typed_return: /RETURN\b/i expression ";"
untyped_return: /RETURN\b/i ";"
microprocessor_dependent_statement: (/DISABLE\b/i | /ENABLE\b/i | /HALT\b/i
    | /CAUSE$INTERRUPT\b/i) ";"

# 4.2 Scoping Statements
simple_do_statement: "DO"i ";"
do_case_statement: "DO"i "CASE"i expression ";"
do_while_statement: "DO"i "WHILE"i expression ";"
iterative_do_statement: "DO"i index_part to_part by_part? ";"
index_part: simple_variable "=" expression
to_part: "TO"i expression
by_part: "BY"i expression
end_statement: "END"i IDENTIFIER? ";"

# 4.3 Conditional Clause
conditional_clause: "IF"i expression "THEN"i unit ("ELSE"i unit)?

# 4.4 Do Blocks
?do_block: simple_do_block | do_case_block | do_while_block | iterative_do_block
block_declarations: declaration*
simple_do_block: simple_do_statement block_declarations unit* ending
ending: label_definition* end_statement
do_case_block: do_case_statement unit* ending
do_while_block: do_while_statement unit* ending
iterative_do_block: iterative_do_statement unit* ending

# 5 EXPRESSIONS
# 5.1 Primaries
?primary: constant | variable_reference | location_reference | subexpression
?subexpression: "(" expression ")"
?constant: numeric_constant | STRING
?variable_reference: subvariable ("." subvariable)?
variable_parameters: "(" expression ("," expression)* ")"
?subvariable: IDENTIFIER variable_parameters?
location_reference: ("@"|".") (constant_list | variable_reference)
constant_list: "(" constant ("," constant)* ")"

# 5.2 Operators
#operator: LOGICAL_OPERATOR | RELATIONAL_OPERATOR | ARITHMETIC_OPERATOR
LOGICAL_OPERATOR: /AND\b/i | /OR\b/i | /NOT\b/i | /XOR\b/i
RELATIONAL_OPERATOR: "<" | ">" | "<=" | ">=" | "<>" | "="
ARITHMETIC_OPERATOR: /[*+-\/]/ | /PLUS\b/i | /MINUS\b/i | /MOD\b/i

# 5.3 Structure of Expressions
expression: logical_expression | embedded_assignment
embedded_assignment: variable_reference ":=" logical_expression
?logical_expression: logical_factor
    | logical_expression (/OR\b/i | /XOR\b/i) logical_factor
?logical_factor: logical_secondary
    | logical_factor /AND\b/i logical_secondary
?logical_secondary: /NOT\b/i? logical_primary
?logical_primary: arithmetic_expression \
        (RELATIONAL_OPERATOR arithmetic_expression)?
?arithmetic_expression: term
    | arithmetic_expression (/[+-]/ | /PLUS\b/i | /MINUS\b/i) term
?term: secondary | term (/[*\/]/ | /MOD\b/i) secondary
secondary: /[+-]/? primary


%import common.WS
%ignore WS
