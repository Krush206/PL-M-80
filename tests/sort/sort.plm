sort:
do;

declare plm label public;

declare bios address data (5);

declare cr literally '13';
declare lf literally '10';

declare c$write literally '2';
declare p$terminate literally '0';

declare tail$address literally '80h';
declare tail$length literally '80h';

declare p$tail address data (tail$address);
declare tail based p$tail (tail$length) byte;

do_sort: procedure (p);
    declare p address;
    declare a based p (1) byte;
    declare i byte;
    declare k byte;
    declare m byte;
    declare t byte;
    do while a(i+1) <> 0;
        m = i;
        k = i + 1;
        do while a(k) <> 0;
            if a(k) < a(m) then
                m = k;
            k = k + 1;
        end;
        t = a(i);
        a(i) = a(m);
        a(m) = t;
        i = i + 1;
    end;
end do_sort;

pr$chr: procedure (c);
    declare c byte;
    call bios(c$write, c);
end pr$chr;

pr$str: procedure (p$str);
    declare p$str address;
    declare str based p$str (1) byte;
    declare i byte;
    i = 0;
    do while str(i) <> 0;
        call pr$chr(str(i));
        i = i + 1;
    end;
end pr$str;

newline: procedure;
    call pr$chr(cr);
    call pr$chr(lf);
end newline;

terminate: procedure;
    call bios(p$terminate, 0);
end terminate;

declare i byte;
declare len byte;

plm:

len = tail(0);
tail(len+1) = 0;

i = 1;
do while tail(i) = ' ';
    i = i + 1;
    len = len - 1;
end;

call do_sort(.tail(i));
call pr$str(.tail(i));
call newline;
call terminate;

end sort;
