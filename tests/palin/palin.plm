palin:
do;

declare plm label public;
declare bdos address data (05h);
declare c$write literally '2';
declare p$term literally '0';
declare boolean literally 'byte';
declare true literally '0ffh';
declare false literally '0';
declare cr literally '13';
declare lf literally '10';


/*
 * Get the length of the zero-terminated string.
 */
str$len: procedure (p$str) byte;
    declare p$str address;
    declare str based p$str (1) byte;
    declare i byte;
    i = 0;
    do while str(i) <> 0;
        i = i + 1;
    end;
    return i;
end str$len;


/*
 * Check if a word is a palindrome.
 * The input string in zero-terminated.
 * An empty string is a palindrome.
 * A one character string is also a palindrome.
 * Palindromes can have either an even or an odd length.
 */
is$palin: procedure (p$str) boolean;
    declare p$str address;
    declare str based p$str (1) byte;
    declare i byte;
    declare len byte;
    len = str$len(p$str);
    if len < 2 then
        return true;
    do i = 0 to len / 2;
        if str(i) <> str(len-1-i) then
            return false;
    end;
    return true;
end is$palin;


pr$chr: procedure (c);
    declare c byte;
    call bdos(c$write, c);
end pr$chr;

newline: procedure;
    call pr$chr(cr);
    call pr$chr(lf);
end newline;

terminate: procedure;
    call bdos(p$term, 0);
end terminate;


/*
 * Print a zero-terminated string to console.
 */
pr$str: procedure (p$str);
    declare p$str address;
    declare str based p$str (1) byte;
    declare i byte;
    i = 0;
    do while str(i) <> 0;
        call pr$chr(str(i));
        i = i + 1;
    end;
end pr$str;

declare p$tail address data (80h);
declare tail based p$tail (1) byte;
declare i byte;

plm:

    tail(tail(0)+1) = 0;
    i = 1;
    do while tail(i) = ' ';
        i = i + 1;
    end;

    if is$palin(.tail(i)) then
        call pr$str(.('Yes', 0));
    else
        call pr$str(.('No', 0));
    call newline;

    call terminate;

end palin;
